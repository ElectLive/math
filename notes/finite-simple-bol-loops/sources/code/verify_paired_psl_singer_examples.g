# Projective Singer normalizer controls, GAP 4.15.1.
# A projective point is an exponent in Z/D, D=(q^n-1)/(q-1):
# primitive multiplication adds 1, Frobenius multiplies by q.
# For q=2 use the full normalizer. For q=3, n even, determinants
# of both primitive multiplication and Frobenius are nonsquares, so
# the PSL intersection is generated by z^2 and z*sigma.
Check:=function(ok,s) if not ok then Print("FAIL ",s,"\n");ForceQuitGap(1);fi;end;;
Check(GAPInfo.Version="4.15.1","version");;
TestSinger:=function(n,q,expected)
 local degree,z,sigma,full,inside,classes,regular,orbits,cl,H,old,duplicate,field,basis,root,mulMat,frobMat,detMul,detFrob;
 degree:=(q^n-1)/(q-1);
 field:=GF(q^n);basis:=Basis(field);root:=Z(q^n);
 mulMat:=List(BasisVectors(basis),v->Coefficients(basis,root*v));
 frobMat:=List(BasisVectors(basis),v->Coefficients(basis,v^q));
 detMul:=DeterminantMat(mulMat);detFrob:=DeterminantMat(frobMat);
 if q=3 then Check(detMul=Z(3) and detFrob=Z(3),"nonsquare determinants");fi;
 z:=PermList(List([0..degree-1],i->(i+1) mod degree+1));
 sigma:=PermList(List([0..degree-1],i->(q*i) mod degree+1));
 full:=Group(z,sigma);
 if q=2 then inside:=full;else inside:=Group(z^2,z*sigma);fi;
 Check(Size(full)=n*degree,"full normalizer order");
 if q=2 then Check(Size(inside)=Size(full),"q2 index");
 else Check(2*Size(inside)=Size(full),"q3 index");fi;
 classes:=ConjugacyClassesSubgroups(inside);
 regular:=Filtered(classes,cl->Size(Representative(cl))=degree and IsTransitive(Representative(cl),[1..degree]));
 orbits:=[];
 for cl in regular do
  H:=Representative(cl);duplicate:=false;
  for old in orbits do if IsConjugate(full,H,old) then duplicate:=true;break;fi;od;
  if not duplicate then Add(orbits,H);fi;
 od;
 Check(Length(orbits)=expected,"regular orbit count");
 Print("n=",n," q=",q," degree=",degree," normalizers=",Size(inside),"/",Size(full),
       " subgroup classes=",Length(classes)," regular inside classes=",Length(regular),
       " full-normalizer orbits=",Length(orbits),"\n");
end;;
TestSinger(4,2,1);;TestSinger(6,2,2);;TestSinger(6,3,1);;TestSinger(4,3,0);;
QUIT_GAP(0);
